# Flask Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Security
SECRET_KEY=dev-secret-key-change-in-production-random-hex-32-chars

# Database Configuration (SQLite default for development)
# In production, can be set to PostgreSQL or MySQL, e.g., postgresql://user:pass@localhost:5432/dbname
DATABASE_URL=sqlite:///instance/web_analytics.db

# Machine Learning Model Configuration
MODEL_DIR=models
MODEL_ARTIFACT_PATH=models/best_conversion_model.joblib
METRICS_PATH=reports/model_metrics.json
DATASET_PATH=data/raw/online_shoppers_intention.csv

# Default Classification Threshold (tunable: 0.0 - 1.0)
# Lower threshold (e.g. 0.35) catches more potential buyers (higher recall) at cost of precision
DEFAULT_DECISION_THRESHOLD=0.40
